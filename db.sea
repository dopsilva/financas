-- db.sea — Camada de banco de dados SQLite e regras de negócio financeiras

local sqlite = require("../sea_vm/libs/sqlite/sqlite")

local M = {}

local SCHEMA = [==[
CREATE TABLE IF NOT EXISTS accounts (
    id               INTEGER PRIMARY KEY AUTOINCREMENT,
    name             TEXT NOT NULL,
    type             TEXT NOT NULL DEFAULT 'checking',
    institution      TEXT NOT NULL DEFAULT '',
    bank_code        TEXT NOT NULL DEFAULT '',
    branch           TEXT NOT NULL DEFAULT '',
    account_number   TEXT NOT NULL DEFAULT '',
    pix_key          TEXT NOT NULL DEFAULT '',
    initial_balance  REAL NOT NULL DEFAULT 0.0,
    color            TEXT NOT NULL DEFAULT '#10b981',
    icon             TEXT NOT NULL DEFAULT 'bank',
    credit_limit     REAL NOT NULL DEFAULT 0.0,
    closing_day      INTEGER NOT NULL DEFAULT 1,
    due_day          INTEGER NOT NULL DEFAULT 10,
    include_in_total INTEGER NOT NULL DEFAULT 1,
    notes            TEXT NOT NULL DEFAULT '',
    active           INTEGER NOT NULL DEFAULT 1,
    created_at       TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS categories (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    name            TEXT NOT NULL,
    type            TEXT NOT NULL,
    color           TEXT NOT NULL DEFAULT '#6366f1',
    icon            TEXT NOT NULL DEFAULT 'tag',
    budget_monthly  REAL NOT NULL DEFAULT 0.0,
    active          INTEGER NOT NULL DEFAULT 1,
    created_at      TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS recurring_rules (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    description     TEXT NOT NULL,
    amount          REAL NOT NULL,
    type            TEXT NOT NULL,
    account_id      INTEGER REFERENCES accounts(id) ON DELETE SET NULL,
    category_id     INTEGER REFERENCES categories(id) ON DELETE SET NULL,
    payment_method  TEXT NOT NULL DEFAULT 'pix',
    contact         TEXT NOT NULL DEFAULT '',
    notes           TEXT NOT NULL DEFAULT '',
    frequency       TEXT NOT NULL DEFAULT 'monthly',
    day_of_month    INTEGER NOT NULL DEFAULT 5,
    start_date      TEXT NOT NULL,
    end_date        TEXT,
    auto_pay        INTEGER NOT NULL DEFAULT 0,
    active          INTEGER NOT NULL DEFAULT 1,
    created_at      TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS transactions (
    id                     INTEGER PRIMARY KEY AUTOINCREMENT,
    description            TEXT NOT NULL,
    amount                 REAL NOT NULL,
    discount               REAL NOT NULL DEFAULT 0.0,
    interest               REAL NOT NULL DEFAULT 0.0,
    type                   TEXT NOT NULL,
    status                 TEXT NOT NULL DEFAULT 'pending',
    due_date               TEXT NOT NULL,
    payment_date           TEXT,
    competence_date        TEXT,
    account_id             INTEGER REFERENCES accounts(id) ON DELETE SET NULL,
    destination_account_id INTEGER REFERENCES accounts(id) ON DELETE SET NULL,
    category_id            INTEGER REFERENCES categories(id) ON DELETE SET NULL,
    payment_method         TEXT NOT NULL DEFAULT 'pix',
    contact                TEXT NOT NULL DEFAULT '',
    notes                  TEXT NOT NULL DEFAULT '',
    tags                   TEXT NOT NULL DEFAULT '',
    recurring_id           INTEGER REFERENCES recurring_rules(id) ON DELETE SET NULL,
    recurring_period       TEXT,
    installment_group      TEXT,
    installment_number     INTEGER,
    installment_total      INTEGER,
    bank_fitid             TEXT,
    reconciled             INTEGER NOT NULL DEFAULT 0,
    created_at             TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_tx_due_date ON transactions(due_date);
CREATE INDEX IF NOT EXISTS idx_tx_payment_date ON transactions(payment_date);
CREATE INDEX IF NOT EXISTS idx_tx_status ON transactions(status);
CREATE INDEX IF NOT EXISTS idx_tx_type ON transactions(type);
CREATE INDEX IF NOT EXISTS idx_tx_account ON transactions(account_id);
CREATE INDEX IF NOT EXISTS idx_tx_category ON transactions(category_id);
CREATE INDEX IF NOT EXISTS idx_tx_fitid ON transactions(bank_fitid);
CREATE INDEX IF NOT EXISTS idx_tx_recurring ON transactions(recurring_id, recurring_period);

CREATE TABLE IF NOT EXISTS goals (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    name            TEXT NOT NULL,
    target_amount   REAL NOT NULL,
    current_amount  REAL NOT NULL DEFAULT 0.0,
    deadline        TEXT,
    color           TEXT NOT NULL DEFAULT '#3b82f6',
    icon            TEXT NOT NULL DEFAULT 'target',
    notes           TEXT NOT NULL DEFAULT '',
    created_at      TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS categorization_rules (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    keyword         TEXT NOT NULL,
    match_type      TEXT NOT NULL DEFAULT 'contains',
    tx_type         TEXT,
    category_id     INTEGER NOT NULL REFERENCES categories(id) ON DELETE CASCADE,
    contact         TEXT NOT NULL DEFAULT '',
    priority        INTEGER NOT NULL DEFAULT 10,
    created_at      TEXT NOT NULL
);
]==]

local function round2(n)
    if n == nil then return 0.0 end
    local num = tonumber(n)
    if num == nil then return 0.0 end
    return math.round(num * 100.0) / 100.0
end

local function today_iso()
    return time.now():format("2006-01-02")
end

local function now_iso()
    return time.now():format("2006-01-02 15:04:05")
end

local function toint(v)
    if v == nil then return nil end
    if type(v) == "int" then return v end
    local n = tonumber(v)
    if n == nil then return nil end
    return math.trunc(n)
end

local function parse_ym(ym)
    if ym == nil or len(ym) < 7 then
        local now = time.now()
        return now:year(), now:month()
    end
    local y = toint(string.sub(ym, 1, 4))
    local m = toint(string.sub(ym, 6, 7))
    if y == nil or m == nil or m < 1 or m > 12 then
        local now = time.now()
        return now:year(), now:month()
    end
    return y, m
end

local function days_in_month(y, m)
    local next_m = m + 1
    local next_y = y
    if next_m > 12 then
        next_m = 1
        next_y = y + 1
    end
    local first_next = time.date(next_y, next_m, 1)
    local last_cur = first_next:add_date(0, 0, -1)
    return last_cur:day()
end

local function month_bounds(ym)
    local y, m = parse_ym(ym)
    local last_day = days_in_month(y, m)
    local start_d = string.format("%04d-%02d-01", y, m)
    local end_d = string.format("%04d-%02d-%02d", y, m, last_day)
    return start_d, end_d, y, m, last_day
end

M.round2 = round2
M.toint = toint
M.today_iso = today_iso
M.now_iso = now_iso
M.parse_ym = parse_ym
M.days_in_month = days_in_month
M.month_bounds = month_bounds

local Store = {}

function M.open(path)
    path = path or "financas.db"
    local db = sqlite.open(path, {wal = true, foreign_keys = true})?
    db:exec(SCHEMA)?
    local s = {}
    s.db = db
    for k, fn in Store do s[k] = fn end
    s:ensure_defaults()?
    return s
end

function Store.close(self)
    return self.db:close()
end

function Store.ensure_defaults(self)
    -- Garante migração de colunas novas caso o banco já exista
    local cols = self.db:query("PRAGMA table_info(accounts)")?
    local has_col = [=]
    for _, c in cols do has_col[c.name] = true end
    if not has_col["bank_code"] then
        self.db:exec("ALTER TABLE accounts ADD COLUMN bank_code TEXT NOT NULL DEFAULT ''")?
    end
    if not has_col["branch"] then
        self.db:exec("ALTER TABLE accounts ADD COLUMN branch TEXT NOT NULL DEFAULT ''")?
    end
    if not has_col["account_number"] then
        self.db:exec("ALTER TABLE accounts ADD COLUMN account_number TEXT NOT NULL DEFAULT ''")?
    end
    if not has_col["pix_key"] then
        self.db:exec("ALTER TABLE accounts ADD COLUMN pix_key TEXT NOT NULL DEFAULT ''")?
    end
    if not has_col["include_in_total"] then
        self.db:exec("ALTER TABLE accounts ADD COLUMN include_in_total INTEGER NOT NULL DEFAULT 1")?
    end
    if not has_col["notes"] then
        self.db:exec("ALTER TABLE accounts ADD COLUMN notes TEXT NOT NULL DEFAULT ''")?
    end

    local cat_count = self.db:value("SELECT count(*) FROM categories")?
    if cat_count == 0 then
        local now = now_iso()
        local default_cats = [
            {name = "Salário", type = "income", color = "#10b981", icon = "briefcase", budget = 0},
            {name = "Freelance / Serviços", type = "income", color = "#06b6d4", icon = "code", budget = 0},
            {name = "Rendimentos / Dividendos", type = "income", color = "#3b82f6", icon = "trending-up", budget = 0},
            {name = "Vendas / Reembolsos", type = "income", color = "#8b5cf6", icon = "repeat", budget = 0},
            {name = "Outras Receitas", type = "income", color = "#14b8a6", icon = "plus-circle", budget = 0},
            {name = "Moradia / Aluguel", type = "expense", color = "#ef4444", icon = "home", budget = 0},
            {name = "Condomínio / Contas Fixas", type = "expense", color = "#f97316", icon = "zap", budget = 0},
            {name = "Supermercado", type = "expense", color = "#eab308", icon = "shopping-cart", budget = 0},
            {name = "Restaurantes / Delivery", type = "expense", color = "#f59e0b", icon = "coffee", budget = 0},
            {name = "Transporte / Combustível", type = "expense", color = "#6366f1", icon = "car", budget = 0},
            {name = "Saúde / Farmácia", type = "expense", color = "#ec4899", icon = "heart", budget = 0},
            {name = "Educação / Cursos", type = "expense", color = "#8b5cf6", icon = "book", budget = 0},
            {name = "Lazer / Entretenimento", type = "expense", color = "#14b8a6", icon = "film", budget = 0},
            {name = "Assinaturas / Streaming", type = "expense", color = "#a855f7", icon = "tv", budget = 0},
            {name = "Compras / Vestuário", type = "expense", color = "#f43f5e", icon = "shopping-bag", budget = 0},
            {name = "Impostos / Taxas Bancárias", type = "expense", color = "#64748b", icon = "file-text", budget = 0},
            {name = "Outras Despesas", type = "expense", color = "#94a3b8", icon = "more-horizontal", budget = 0},
        ]
        for _, c in default_cats do
            self.db:exec(
                "INSERT INTO categories (name, type, color, icon, budget_monthly, created_at) VALUES (?, ?, ?, ?, ?, ?)",
                c.name, c.type, c.color, c.icon, c.budget, now
